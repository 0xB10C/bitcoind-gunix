+/* bitcoind-gunix: optional CANONICAL rewrite applied before the debug
+   prefix maps, configured via the NIX_DEBUG_CANON_PREFIX_MAP
+   environment variable ("OLD=NEW[:OLD=NEW...]"; first matching pair
+   wins).  Unlike -fdebug-prefix-map this rewrite is also applied to
+   the DWARF file table's lookup keys (lookup_filename), making it
+   transparent to the table's dedupe logic — the compilation behaves
+   exactly as if it had actually run under NEW.  Two reasons to use it
+   over -fdebug-prefix-map when byte-reproducing a build whose
+   reference environment compiles at a path (NEW) the sandbox cannot
+   provide:
+   (a) a plain -fdebug-prefix-map=OLD=NEW changes how many file table
+       entries the MAIN file gets (a remapped main file enters the
+       table under two different keys), shifting the gas-generated
+       DWARF line tables relative to the reference; and
+   (b) remap_filename allocates every fired rewrite with ggc_alloc —
+       a map that fires where the reference environment fires none
+       (e.g. our store-side depends tree vs GUIX's unmapped real
+       /bitcoin path) perturbs the GGC allocation stream and flips
+       var-tracking's .debug_loclists representative choice in large
+       CUs (verified: an IDENTITY -ffile-prefix-map=X=X alone flips
+       them).  The canon rewrite is malloc'd, hence GGC-neutral.
+   Read once; no effect when unset.  */
+
+#define CANON_MAX_PAIRS 8
+static const char *canon_old_prefix[CANON_MAX_PAIRS];
+static const char *canon_new_prefix[CANON_MAX_PAIRS];
+static size_t canon_old_len[CANON_MAX_PAIRS];
+static size_t canon_new_len[CANON_MAX_PAIRS];
+static int canon_npairs;
+static bool canon_parsed;
+
+const char *
+canon_debug_filename (const char *filename)
+{
+  if (!canon_parsed)
+    {
+      canon_parsed = true;
+      const char *spec = getenv ("NIX_DEBUG_CANON_PREFIX_MAP");
+      while (spec && *spec && canon_npairs < CANON_MAX_PAIRS)
+	{
+	  const char *end = strchr (spec, ':');
+	  size_t pair_len = end ? (size_t) (end - spec) : strlen (spec);
+	  const char *sep = (const char *) memchr (spec, '=', pair_len);
+	  if (sep && sep != spec)
+	    {
+	      int i = canon_npairs++;
+	      canon_old_prefix[i] = xstrndup (spec, sep - spec);
+	      canon_old_len[i] = sep - spec;
+	      canon_new_prefix[i] = xstrndup (sep + 1,
+					      spec + pair_len - (sep + 1));
+	      canon_new_len[i] = strlen (canon_new_prefix[i]);
+	    }
+	  spec = end ? end + 1 : NULL;
+	}
+    }
+  if (!canon_npairs || !filename)
+    return filename;
+
+  for (int i = 0; i < canon_npairs; i++)
+    {
+      if (filename_ncmp (filename, canon_old_prefix[i],
+			 canon_old_len[i]) != 0)
+	continue;
+      const char *name = filename + canon_old_len[i];
+      size_t name_len = strlen (name) + 1;
+      char *s = XNEWVEC (char, name_len + canon_new_len[i]);
+      memcpy (s, canon_new_prefix[i], canon_new_len[i]);
+      memcpy (s + canon_new_len[i], name, name_len);
+      return s;
+    }
+  return filename;
+}
+
